---
const currentYear = new Date().getFullYear();
---

<footer class="footer">
  <div class="footer-container container">
    <div class="footer-content">
      <div class="footer-brand">
        <img
          src="/assets/img/logo-nike-name.svg"
          alt="Jacket Store"
          class="footer-logo"
        />
        <p class="footer-desc">
          Thand se bachne ka bahana, style dikhane ka zamana.
        </p>
      </div>

      <div class="footer-links">
        <h4 class="footer-title">Quick Links</h4>
        <ul>
          <li><a href="/" class="footer-link">Aura Farm</a></li>
          <li><a href="/categories" class="footer-link">Jacket Ki Dukan</a></li>
          <li><a href="/about" class="footer-link">Hum Kaun Hai?</a></li>
          <li><a href="/special" class="footer-link">Special</a></li>
          <li><a href="/contact" class="footer-link">Baat Karne ke liye</a></li>
        </ul>
      </div>

      <div class="footer-social">
        <h4 class="footer-title">Follow Us</h4>
        <div class="footer-social-icons">
          <a href="#" aria-label="Facebook"
            ><i class="ri-facebook-fill"></i
          ></a>
          <a href="https://www.instagram.com/utpal8771" aria-label="Instagram"
            ><i class="ri-instagram-line"></i
          ></a>
          <a href="#" aria-label="Twitter"
            ><i class="ri-twitter-x-fill"></i
          ></a>
          <a href="#" aria-label="YouTube"
            ><i class="ri-youtube-fill"></i
          ></a>
        </div>
      </div>
    </div>

    <div class="footer-bottom">
      <p>&copy; {currentYear} Jacket Store. All rights reserved.</p>
    </div>
  </div>
</footer>

<style>
  .footer {
    background: hsl(0, 0%, 8%);
    color: var(--white-color);
    padding-block: 3rem 1.5rem;
  }

  .footer-content {
    display: grid;
    gap: 2rem;
  }

  .footer-logo {
    width: clamp(50px, 12vw, 60px);
    margin-bottom: 1rem;
  }

  .footer-desc {
    font-size: var(--small-font-size);
    opacity: 0.7;
    max-width: 280px;
    line-height: 1.6;
  }

  .footer-title {
    font-size: var(--normal-font-size);
    font-weight: 600;
    margin-bottom: 1rem;
  }

  .footer-links ul {
    display: flex;
    flex-direction: column;
    row-gap: 0.75rem;
  }

  .footer-link {
    color: var(--white-color);
    opacity: 0.7;
    font-size: var(--small-font-size);
    transition: opacity 0.3s;
    padding-block: 0.25rem;
    display: inline-block;
  }

  .footer-link:hover {
    opacity: 1;
  }

  .footer-social-icons {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
  }

  .footer-social-icons a {
    color: var(--white-color);
    font-size: 1.25rem;
    opacity: 0.7;
    transition: opacity 0.3s;
    min-width: 44px;
    min-height: 44px;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .footer-social-icons a:hover {
    opacity: 1;
  }

  .footer-bottom {
    margin-top: 2.5rem;
    padding-top: 1.5rem;
    border-top: 1px solid hsla(0, 0%, 100%, 0.1);
    text-align: center;
    font-size: var(--small-font-size);
    opacity: 0.5;
  }

  @media (width >= 480px) {
    .footer-content {
      grid-template-columns: 1fr 1fr;
    }

    .footer-brand {
      grid-column: 1 / -1;
    }
  }

  @media (width >= 768px) {
    .footer {
      padding-block: 4rem 2rem;
    }

    .footer-content {
      grid-template-columns: 2fr 1fr 1fr;
      gap: 3rem;
    }

    .footer-brand {
      grid-column: initial;
    }
  }

  @media (width >= 1150px) {
    .footer-content {
      gap: 4rem;
    }
  }
</style>
