---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
---

<Layout>
  <Header />
  <main class="main">
    <section class="page-hero">
      <div class="container">
        <h1 class="page-title">About Us</h1>
        <p class="page-subtitle">Crafted for the journey ahead</p>
      </div>
    </section>

    <section class="about-story container">
      <div class="about-content">
        <h2>Our Story</h2>
        <p>
          Founded with a passion for quality and design, Jacket Store was born from the belief that
          outerwear should be as functional as it is fashionable. Every piece in our collection is
          carefully selected to offer the perfect balance of durability, comfort, and style.
        </p>
        <p>
          From city streets to mountain trails, our jackets are designed to move with you. We partner
          with trusted manufacturers who share our commitment to craftsmanship and sustainability.
        </p>
      </div>

      <div class="about-values">
        <h2>What We Stand For</h2>
        <div class="values-grid">
          <div class="value-card">
            <i class="ri-shield-check-line value-icon"></i>
            <h3>Quality First</h3>
            <p>Every stitch matters. We source premium materials for lasting wear.</p>
          </div>
          <div class="value-card">
            <i class="ri-leaf-line value-icon"></i>
            <h3>Sustainable</h3>
            <p>Eco-conscious production and packaging for a better tomorrow.</p>
          </div>
          <div class="value-card">
            <i class="ri-user-heart-line value-icon"></i>
            <h3>Customer Focused</h3>
            <p>Your satisfaction drives everything we do.</p>
          </div>
          <div class="value-card">
            <i class="ri-global-line value-icon"></i>
            <h3>Worldwide Shipping</h3>
            <p>Delivering premium outerwear to doors around the globe.</p>
          </div>
        </div>
      </div>
    </section>
  </main>
  <Footer />
</Layout>

<style>
  .page-hero {
    padding-block: 9rem 3rem;
    background: var(--purple-color-gradient);
    text-align: center;
    color: var(--white-color);
  }

  .page-title {
    font-size: 2rem;
    font-weight: 700;
    margin-bottom: 0.5rem;
  }

  .page-subtitle {
    font-size: var(--normal-font-size);
    opacity: 0.9;
  }

  .about-story {
    padding-block: 3rem 5rem;
  }

  .about-content h2,
  .about-values h2 {
    font-size: 1.5rem;
    font-weight: 700;
    margin-bottom: 1rem;
    color: hsl(0, 0%, 12%);
  }

  .about-content p {
    color: hsl(0, 0%, 35%);
    line-height: 1.8;
    margin-bottom: 1rem;
    font-size: var(--normal-font-size);
  }

  .about-values {
    margin-top: 3rem;
  }

  .values-grid {
    display: grid;
    gap: 1.5rem;
  }

  .value-card {
    background: hsl(0, 0%, 98%);
    border-radius: 1.25rem;
    padding: 2rem;
    text-align: center;
    transition: transform 0.3s;
  }

  .value-card:hover {
    transform: translateY(-4px);
  }

  .value-icon {
    font-size: 2rem;
    color: hsl(259, 70%, 55%);
    margin-bottom: 1rem;
    display: inline-block;
  }

  .value-card h3 {
    font-size: 1.125rem;
    font-weight: 600;
    margin-bottom: 0.5rem;
    color: hsl(0, 0%, 12%);
  }

  .value-card p {
    font-size: var(--small-font-size);
    color: hsl(0, 0%, 40%);
    line-height: 1.5;
  }

  @media (width >= 640px) {
    .values-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (width >= 1150px) {
    .page-hero {
      padding-block: 11rem 4rem;
    }

    .page-title {
      font-size: 2.5rem;
    }

    .about-content {
      max-width: 720px;
    }

    .values-grid {
      grid-template-columns: repeat(4, 1fr);
    }
  }
</style>
