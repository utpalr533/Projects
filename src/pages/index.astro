---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import Hero from "../components/Hero.astro";
import Footer from "../components/Footer.astro";
---

<Layout>
  <Header />
  <main class="main">
    <Hero />
  </main>
  <Footer />
  <script is:inline>
    /*=============== SWIPER HOME ===============*/
    const swiperHome = new Swiper(".home-swiper", {
      loop: true,
      speed: 800,
      effect: "fade",
      parallax: true,
      pagination: {
        el: ".swiper-pagination",
        clickable: true,
      },
      autoplay: {
        delay: 3000,
        disableOnInteraction: false,
      },
    });

    /*=============== SCROLL HEADER ===============*/
    const scrollHeader = () => {
      const header = document.getElementById("header");
      window.scrollY >= 50
        ? header.classList.add("scroll-header")
        : header.classList.remove("scroll-header");
    };
    window.addEventListener("scroll", scrollHeader);

    /*=============== GSAP ANIMATION ===============*/
    gsap.defaults({ opacity: 0, ease: "power4.out", duration: 1.4 });

    const tl = gsap.timeline();
    tl.from(".home-logoes img", { y: 200, stagger: 0.15 }, ".3")
      .from(".nav > *", { y: -30 }, ".9")
      .from(".home-data", { y: 60 }, "1.2")
      .from(".home-image", { y: 100 }, "1.5")
      .from(".home .swiper-pagination", { scale: 0, opacity: 1 }, "1.5");
  </script>
</Layout>
