---
const placeholder = "What needs to be done?";
const filterOptions = ["All", "Active", "Completed"];
---

<div
  id="app-root"
  style="background-color: var(--bg-page); min-height: 100vh;"
>
  <div class="bg-primary">
    <div class="relative mx-auto flex max-w-2xl items-start px-6 py-16 md:py-20">
      <div class="flex-1 text-center">
        <p class="text-xs font-medium uppercase tracking-[0.324px] text-on-primary/70">
          Task Manager
        </p>
        <h1 class="mt-3 font-display text-4xl font-light leading-[1.25] tracking-[-0.1px] text-on-primary md:text-5xl">
          My Tasks
        </h1>
        <p class="mt-2 text-base leading-relaxed text-on-primary/70">
          Stay organized. Stay focused.
        </p>
      </div>
      <button
        id="theme-toggle"
        class="absolute right-6 top-16 flex h-10 w-10 cursor-pointer items-center justify-center rounded-full transition-colors hover:bg-white/10 md:top-20"
        aria-label="Toggle theme"
      >
        <svg id="sun-icon" class="hidden" width="20" height="20" viewBox="0 0 20 20" fill="none">
          <circle cx="10" cy="10" r="4" stroke="white" stroke-width="1.5"/>
          <path d="M10 1V3M10 17V19M19 10H17M3 10H1M16.66 3.34L15.24 4.76M4.76 15.24L3.34 16.66M16.66 16.66L15.24 15.24M4.76 4.76L3.34 3.34" stroke="white" stroke-width="1.5" stroke-linecap="round"/>
        </svg>
        <svg id="moon-icon" class="block" width="20" height="20" viewBox="0 0 20 20" fill="none">
          <path d="M17.39 10.74A8 8 0 019.26 2.61 8 8 0 1017.39 10.74z" stroke="white" stroke-width="1.5" stroke-linejoin="round"/>
        </svg>
      </button>
    </div>
  </div>

  <div class="mx-auto max-w-2xl px-6">
    <div class="-mt-8 flex gap-3">
      <input
        id="todo-input"
        type="text"
        placeholder={placeholder}
        style="background-color: var(--bg-input); color: var(--text-primary); border-color: var(--border-input);"
        class="h-12 flex-1 rounded-sm border px-4 text-lg outline-none transition-shadow placeholder:text-body-light focus:border-2 focus:border-primary"
      />
      <button
        id="add-btn"
        class="h-12 cursor-pointer rounded-full bg-primary px-7 text-lg font-bold tracking-[0.45px] text-on-primary transition-colors hover:bg-primary-pressed active:bg-primary-active"
      >
        Add
      </button>
    </div>

    <div class="mt-8 flex items-center justify-between" id="filter-bar">
      <div class="flex gap-2">
        {filterOptions.map((opt) => (
          <button
            class="filter-btn cursor-pointer rounded-full px-4 py-2 text-sm font-bold tracking-[0.324px] transition-colors"
            style="background-color: var(--bg-filter); color: var(--text-filter-inactive);"
            data-filter={opt}
          >
            {opt}
          </button>
        ))}
      </div>
      <div id="todo-stats" class="text-sm" style="color: var(--text-secondary);">
        <span id="remaining-count">0</span> items
      </div>
    </div>

    <ul id="todo-list" class="mt-4 space-y-2 pb-16">
    </ul>
  </div>
</div>


<script>
// @ts-nocheck
  const THEME_KEY = "todo-app-theme";
  const STORAGE_KEY = "todo-app-tasks";

  let todos = [];
  let currentFilter = "All";
  let currentTheme = "light";

  const root = document.documentElement;
  const input = document.getElementById("todo-input");
  const addBtn = document.getElementById("add-btn");
  const list = document.getElementById("todo-list");
  const remainingCount = document.getElementById("remaining-count");
  const filterBtns = document.querySelectorAll(".filter-btn");
  const themeToggle = document.getElementById("theme-toggle");
  const sunIcon = document.getElementById("sun-icon");
  const moonIcon = document.getElementById("moon-icon");

  function setTheme(theme) {
    currentTheme = theme;
    if (theme === "dark") {
      root.classList.add("dark");
      sunIcon.classList.remove("hidden");
      moonIcon.classList.add("hidden");
    } else {
      root.classList.remove("dark");
      sunIcon.classList.add("hidden");
      moonIcon.classList.remove("hidden");
    }
    localStorage.setItem(THEME_KEY, theme);
  }

  function toggleTheme() {
    setTheme(currentTheme === "dark" ? "light" : "dark");
  }

  function loadTheme() {
    const saved = localStorage.getItem(THEME_KEY);
    if (saved === "dark" || (!saved && window.matchMedia("(prefers-color-scheme: dark)").matches)) {
      setTheme("dark");
    } else {
      setTheme("light");
    }
  }

  function loadTodos() {
    try {
      const stored = localStorage.getItem(STORAGE_KEY);
      if (stored) {
        todos = JSON.parse(stored);
      }
    } catch {
      todos = [];
    }
  }

  function saveTodos() {
    localStorage.setItem(STORAGE_KEY, JSON.stringify(todos));
  }

  function getFilteredTodos() {
    if (currentFilter === "Active") return todos.filter((t) => !t.done);
    if (currentFilter === "Completed") return todos.filter((t) => t.done);
    return todos;
  }

  function getRemainingCount() {
    return todos.filter((t) => !t.done).length;
  }

  function render() {
    const filtered = getFilteredTodos();
    const remaining = getRemainingCount();

    remainingCount.textContent = remaining;

    filterBtns.forEach((btn) => {
      const isActive = btn.dataset.filter === currentFilter;
      if (isActive) {
        btn.style.backgroundColor = "var(--bg-filter-active)";
        btn.style.color = "#000000";
      } else {
        btn.style.backgroundColor = "var(--bg-filter)";
        btn.style.color = "var(--text-filter-inactive)";
      }
    });

    if (filtered.length === 0) {
      list.innerHTML = `<li
        class="td-card rounded-md px-6 py-12 text-center transition-shadow"
      >
        <p class="text-lg font-light" style="color: var(--text-primary);">No tasks here</p>
        <p class="mt-1 text-sm" style="color: var(--text-secondary);">${
          currentFilter === "All"
            ? "Add a task to get started"
            : currentFilter === "Active"
              ? "All tasks are done!"
              : "No completed tasks yet"
        }</p>
      </li>`;
      return;
    }

    list.innerHTML = filtered
      .map(
        (todo) => `
      <li
        class="td-card group flex items-center gap-4 rounded-md px-5 py-4 transition-shadow"
        data-id="${todo.id}"
      >
        <button
          class="todo-toggle flex h-6 w-6 shrink-0 items-center justify-center rounded-full border-2 transition-colors ${
            todo.done ? "done" : ""
          }"
          data-id="${todo.id}"
        >
          ${
            todo.done
              ? `<svg width="14" height="14" viewBox="0 0 14 14" fill="none"><path d="M2 7.5L5 10.5L12 3.5" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>`
              : ""
          }
        </button>
        <span
          class="flex-1 text-lg ${todo.done ? "todo-text-done" : "todo-text-active"}"
        >
          ${escapeHtml(todo.text)}
        </span>
        <button
          class="todo-delete flex h-8 w-8 shrink-0 items-center justify-center rounded-full opacity-0 transition-all group-hover:opacity-100"
          data-id="${todo.id}"
        >
          <svg width="18" height="18" viewBox="0 0 18 18" fill="none">
            <path d="M4 4L14 14M14 4L4 14" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
          </svg>
        </button>
      </li>`
      )
      .join("");
  }

  function escapeHtml(str) {
    const div = document.createElement("div");
    div.textContent = str;
    return div.innerHTML;
  }

  function addTodo() {
    const text = input.value.trim();
    if (!text) return;

    todos.push({
      id: Date.now().toString(),
      text,
      done: false,
      createdAt: new Date().toISOString(),
    });

    input.value = "";
    saveTodos();
    render();
    input.focus();
  }

  function toggleTodo(id) {
    const todo = todos.find((t) => t.id === id);
    if (todo) {
      todo.done = !todo.done;
      saveTodos();
      render();
    }
  }

  function deleteTodo(id) {
    todos = todos.filter((t) => t.id !== id);
    saveTodos();
    render();
  }

  function handleListClick(e) {
    const toggleBtn = e.target.closest(".todo-toggle");
    const deleteBtn = e.target.closest(".todo-delete");

    if (toggleBtn) {
      toggleTodo(toggleBtn.dataset.id);
    } else if (deleteBtn) {
      deleteTodo(deleteBtn.dataset.id);
    }
  }

  function handleFilterClick(e) {
    const btn = e.target.closest(".filter-btn");
    if (btn) {
      currentFilter = btn.dataset.filter;
      render();
    }
  }

  function handleKeydown(e) {
    if (e.key === "Enter") {
      addTodo();
    }
  }

  loadTheme();
  loadTodos();
  render();

  themeToggle.addEventListener("click", toggleTheme);
  addBtn.addEventListener("click", addTodo);
  input.addEventListener("keydown", handleKeydown);
  list.addEventListener("click", handleListClick);
  document.getElementById("filter-bar").addEventListener("click", handleFilterClick);
</script>
